---
// Page for a product that has no hand-built page of its own, built from src/data/products.ts.
// A product at an earlier stage simply has less to show: no section is filled with invented content.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import Crumbs from '../../components/Crumbs.astro';
import ProductMediaView from '../../components/ProductMediaView.astro';
import { breadcrumbs, softwareApplication, webPage } from '../../lib/schema';
import { serviceBySlug, serviceUrl, type Service } from '../../data/services';
import { badgeClass, PRODUCTS, type Product } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.filter((p) => p.generatedPage).map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const related = (p.services ?? []).map(serviceBySlug).filter((s): s is Service => Boolean(s));
const seo = {
  title: p.metaTitle ?? `${p.name} | Rirote Global`,
  path: p.path,
  description: p.description,
  schema: [
    webPage({ path: p.path, name: p.name }),
    softwareApplication({
      path: p.path,
      name: p.name,
      description: p.description,
      category: p.appCategory ?? 'BusinessApplication',
      license: p.license,
      sameAs: p.link?.href,
      operatingSystem: p.os,
      free: p.free,
      downloadUrl: p.download?.available ? p.download.href : undefined,
      softwareVersion: p.download?.available ? p.download.version : undefined,
    }),
    breadcrumbs(['Home', '/'], ['Products', '/products'], [p.name, p.path]),
  ],
};
const heading = p.heading ?? [p.name, ''];
const badge = badgeClass(p.status);
const inDev = p.status === 'In development';
const dl = p.download;
const contact = p.contact ?? (inDev
  ? { eyebrow: 'Get Access', title: 'Tell us you are interested.', lead: 'We will write to you when it is ready.', message: `I would like to hear more about ${p.name}.` }
  : { eyebrow: 'Talk to Us', title: 'Want this in your product?', lead: 'Tell us about your product and where AI could help.', message: 'I would like to talk about AI in our product.' });
---
<BaseLayout seo={seo} nav={{ current: 'products' }}>
<main id="main">
  <section class:list={['page-hero dark', { 'ph-media': p.hero }]}>
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['Products', '/products'], [p.short]]} />
      <p style="margin:10px 0 6px"><span class:list={['badge', badge]}>{p.status}</span></p>
      <h1 class="page-title" style="font-size:clamp(2.4rem,5.4vw,4.6rem);color:#fff">{heading[0]} <span style="color:var(--cyan)">{heading[1]}</span></h1>
      <p class="page-sub" style="color:var(--on-dark-2)">{p.intro}</p>
      <div class="hero-actions">
        {dl
          ? (dl.available
            ? <a class="btn-primary" href={dl.href} download>{dl.label}</a>
            : <span class="btn-primary is-off" aria-disabled="true">{dl.label} · coming soon</span>)
          : p.link
            ? <a class="btn-primary" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
            : <a class="btn-primary" href="#access">{p.cta}</a>}
        {p.requirements && <a class="btn-outline" href="#requirements">Requirements</a>}
      </div>
      {dl && <p class="dl-line">{dl.platformLine}{dl.available && dl.version && ` · Version ${dl.version}`}{dl.available && dl.size && ` · ${dl.size}`}</p>}
    </div>
    {p.hero && <div class="ph-shot"><ProductMediaView media={p.hero} eager /></div>}
  </section>

  <section class="band" aria-labelledby="does-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="does-title">What it does</h2></div>
      <ul class="pts" style="max-width:62ch">{p.points.map((x) => <li style="font-size:1.05rem">{x}</li>)}</ul>
      {p.note && <p class="note2"><b>Status.</b> {p.note}</p>}
    </div>
  </section>

  {p.features && p.features.length > 0 && (
    <section class="band" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="sec-h" data-reveal><h2 class="section-title" id="features-title">How it works</h2></div>
        <nav class="feat-jump" aria-label="Features">{p.features.map((f) => <a href={`#${f.id}`}>{f.title}</a>)}</nav>
        <div class="feats">
          {p.features.map((f) => (
            <article class:list={['feat', { 'no-media': !f.media }]} id={f.id} data-reveal>
              <div class="feat-text">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                {f.points && <ul class="ticks">{f.points.map((x) => <li>{x}</li>)}</ul>}
              </div>
              {f.media && <ProductMediaView media={f.media} />}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {(p.requirements || p.firstRun) && (
    <section class="band" id="requirements" aria-labelledby="req-title">
      <div class="wrap req-grid">
        {p.requirements && (
          <div>
            <div class="sec-h" data-reveal><h2 class="section-title" id="req-title">Requirements</h2></div>
            <dl class="req">
              {p.requirements.map((r) => (
                <div><dt>{r.label}{r.optional && <span class="req-opt">Optional</span>}</dt><dd>{r.value}</dd></div>
              ))}
            </dl>
          </div>
        )}
        {p.firstRun && (
          <div>
            <h3 class="h2s" style="font-size:clamp(1.5rem,2.6vw,2rem)">Before you start</h3>
            <ol class="firstrun">{p.firstRun.map((x) => <li>{x}</li>)}</ol>
            {dl && (dl.available
              ? <a class="btn-primary" href={dl.href} download style="margin-top:22px">{dl.label}</a>
              : <span class="btn-primary is-off" aria-disabled="true" style="margin-top:22px">{dl.label} · coming soon</span>)}
          </div>
        )}
      </div>
      {p.credits && <div class="wrap"><p class="credits">{p.credits}</p></div>}
    </section>
  )}

  {related.length > 0 && (
    <section class="band" aria-labelledby="related-title">
      <div class="wrap">
        <div class="sec-h" data-reveal><h2 class="section-title" id="related-title">Related services</h2></div>
        <div class="rel">{related.map((s) => <a href={serviceUrl(s.slug)}><b>{s.name}</b><span>{s.summary}</span></a>)}</div>
      </div>
    </section>
  )}

  <section class="band dark" id="access" aria-labelledby="access-title">
    <div class="wrap">
      <ContactPanel eyebrow={contact.eyebrow} title={contact.title} titleId="access-title"
        lead={contact.lead} service={p.formService} message={contact.message} />
    </div>
  </section>
</main>
</BaseLayout>
