---
// Homepage, "Index" redesign (2026-11). Phone-first: one idea per screen, real work before claims.
// Order: hero → what we build (with Found Everywhere and Code Vaidya aftercare inside its tabs) → recent work
// (with the NimNim "case in focus") → services → products → partner → contact. Full stories live on their pages.
// Page styles: /assets/home.css, behaviour: /assets/home.js.
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ServicePicker from '../components/ServicePicker.astro';
import HeroStack from '../components/home/HeroStack.astro';
import BuildShowcase from '../components/home/BuildShowcase.astro';
import WorkGallery from '../components/home/WorkGallery.astro';
import { organization, website } from '../lib/schema';
import { COMPANY_STATS } from '../data/site';
import { CASES, PROJECTS_PATH } from '../data/cases';
import { PRODUCTS, badgeClass } from '../data/products';

const seo = {
  title: 'Rirote Global | Software, AI & ERP Development in Jaipur',
  path: '/',
  description: 'Rirote Global builds full-stack products, AI agents and ERP integrations for businesses in India and worldwide. Based in Jaipur. Makers of ERPTick.',
  ogDescription: 'Websites, business software, AI assistants and ERP integration from a Jaipur team. Makers of ERPTick.',
  twitterDescription: 'Websites, business software, AI assistants and ERP integration from a Jaipur team.',
  schema: [organization(), website()],
};

const HERO_STATS = [COMPANY_STATS.projects, COMPANY_STATS.industries, COMPANY_STATS.regions];
const productOrder = ['erptick', 'rirote-vision', 'code-vaidya'];
const products = productOrder.map((id) => PRODUCTS.find((p) => p.id === id)!).filter(Boolean);
const openSource = PRODUCTS.filter((p) => p.group === 'Open source');
const icon: Record<string, string> = { 'rirote-vision': '/assets/products/rirote-vision/logo-animated.svg', 'code-vaidya': '/assets/products/code-vaidya/logo-mark.svg' };
const stops: Array<[string, string]> = [['start', 'Start'], ['build', 'Build'], ['work', 'Work'], ['services', 'Services'], ['products', 'Products'], ['partner', 'Partner'], ['contact', 'Talk']];
---
<BaseLayout seo={seo} rail={{ stops, summitLabel: 'Start a project' }}>
<Fragment slot="head"><link rel="stylesheet" href="/assets/home.css"></Fragment>
<main id="main">

<section class="hero0 hx-hero wrap dark" id="start">
  <div class="hx-head">
    <p class="eyebrow">Rise with Robust Tech</p>
    <h1>We build websites, web apps and AI tools for businesses that need them to work.</h1>
  </div>
  <HeroStack />
  <div class="hx-copy">
    <p class="page-sub">We build websites and business software, add AI that works with your data, and connect your ERP to your tools. A team in Jaipur, working with clients in India, the US and the Middle East.</p>
    <p class="cred">Built by engineers who worked at multinational companies, for clients around the world.</p>
    <div class="cta-row">
      <a href="#contact" class="btn-primary">Start a project</a>
      <a href="#work" class="btn-outline">See the work</a>
    </div>
    <div class="rise-art" aria-hidden="true"><i style="--h:10;--i:0"></i><i style="--h:14;--i:1"></i><i style="--h:12;--i:2"></i><i style="--h:19;--i:3"></i><i style="--h:16;--i:4"></i><i style="--h:24;--i:5"></i><i style="--h:21;--i:6"></i><i style="--h:30;--i:7"></i><i style="--h:27;--i:8"></i><i style="--h:36;--i:9"></i><i style="--h:32;--i:10"></i><i style="--h:43;--i:11"></i><i style="--h:39;--i:12"></i><i style="--h:51;--i:13"></i><i style="--h:47;--i:14"></i><i style="--h:60;--i:15"></i><i style="--h:56;--i:16"></i><i style="--h:70;--i:17"></i><i style="--h:66;--i:18"></i><i style="--h:82;--i:19"></i><i style="--h:78;--i:20"></i><i style="--h:100;--i:21"></i><svg viewBox="12 8 43 48" width="26" height="29"><defs><linearGradient id="rg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0077b6"/><stop offset="1" stop-color="#00d4ff"/></linearGradient></defs><path fill="url(#rg)" fill-rule="evenodd" d="M13 9H37C46.9 9 54 15.8 54 24.8C54 31.4 50.2 36.7 44.4 39L54 55H41.6L33.4 40.6H25V55H13ZM33.5 15.5L42.6 26.4H36.9V32.8H30.1V26.4H24.4Z"/></svg></div>
    <div class="stats" aria-label="Rirote Global in numbers">
      {HERO_STATS.map((s) => <div><b data-count>{s.value}</b><span>{s.label}</span></div>)}
    </div>
  </div>
</section>

<section class="band" id="build" aria-labelledby="build-h">
  <div class="wrap">
    <p class="eyebrow">What we build</p>
    <h2 class="section-title" id="build-h" style="margin-top:12px">Real work, not a list of services.</h2>
    <BuildShowcase />
  </div>
</section>

<section class="band dark" id="work" aria-labelledby="work-h" style="padding-bottom:48px">
  <div class="wrap">
    <p class="eyebrow">Case studies</p>
    <h2 class="section-title" id="work-h" style="margin-top:12px">Recent work and what changed.</h2>
  </div>
  <div style="margin-top:56px"><WorkGallery /></div>
  <div class="wrap hx-focus">
    <div>
      <p class="eyebrow">Case in focus · NimNim</p>
      <h3>A hacker’s script tried to flood a live platform with fake accounts. We stopped it.</h3>
    </div>
    <ul class="shield-attack" aria-label="The attack">
      <li><b>Every second</b><span>a new fake sign-up request</span></li>
      <li><b>8–10 h</b><span>the script kept running</span></li>
      <li><b>Millions</b><span>of requests overall</span></li>
      <li><b class="ok">Stopped</b><span>fake account creation</span></li>
    </ul>
    <p class="hx-links"><a href="/projects/nimnim#protection">See how we stopped it →</a><a href={PROJECTS_PATH}>All {CASES.length} case studies →</a></p>
  </div>
</section>

<section class="band" id="services" aria-labelledby="services-h">
  <div class="wrap">
    <p class="eyebrow">What we do</p>
    <h2 class="section-title" id="services-h" style="margin-top:12px">Our services</h2>
    <p class="section-sub">From your first website to connecting your ERP. One team plans it, builds it and looks after it once it is live.</p>
    <div style="margin-top:28px"><ServicePicker /></div>
    <p class="seeall"><a class="hx-more" href="/services">All services →</a></p>
  </div>
</section>

<section class="band dark" id="products" aria-labelledby="products-h">
  <div class="wrap">
    <p class="eyebrow">Products</p>
    <h2 class="section-title" id="products-h" style="margin-top:12px">Software we build and run ourselves.</h2>
    <ul class="hx-plist" style="margin-top:28px">
      {products.map((p) => (
        <li>
          <span class="hx-ico" aria-hidden="true">{icon[p.id] ? <img src={icon[p.id]} alt="" width="56" height="56" loading="lazy"> : p.short.slice(0, 2)}</span>
          <h3><a href={p.path}>{p.name}</a>{p.status && <span class:list={['badge', badgeClass(p.status)]}>{p.status}</span>}</h3>
          <p>{p.line}</p>
        </li>
      ))}
      <li>
        <span class="hx-ico" aria-hidden="true">{'{ }'}</span>
        <h3>Open source</h3>
        <p>Free tools for people building with AI: {openSource.map((p, i) => <>{i > 0 && (i === openSource.length - 1 ? ' and ' : ', ')}<a href={p.path} target={p.path.startsWith('http') ? '_blank' : undefined} rel={p.path.startsWith('http') ? 'noopener' : undefined}>{p.name}</a></>)}.</p>
      </li>
    </ul>
    <p class="seeall"><a class="hx-more" href="/products">All products →</a></p>
  </div>
</section>

<section class="band" id="partner" aria-labelledby="partner-h">
  <div class="wrap">
    <p class="eyebrow">Start with us</p>
    <h2 class="section-title" id="partner-h" style="margin-top:12px">Have the idea, but not the tech team?</h2>
    <p class="section-sub">You know your market and how to run the business. Building the software, scaling it, and handing an agency the whole budget up front is the hard part. So start small, and go further only when it is working.</p>
    <ol class="hx-ladder">
      <li><span class="hx-meter" aria-hidden="true"><i class="on"></i><i></i><i></i></span><b>Start small</b><p>A prototype or a first version (MVP), whichever fits the idea.</p></li>
      <li><span class="hx-meter" aria-hidden="true"><i class="on"></i><i class="on"></i><i></i></span><b>Build in stages</b><p>Stages you can see and use, each one agreed before it starts.</p></li>
      <li><span class="hx-meter" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i></span><b>Partner with us</b><p>We take on the website and web app side with you and share the risk, on terms that suit the idea.</p></li>
    </ol>
    <p class="cta-row"><a class="btn-primary" href="/partner-with-us">How partnering works</a><a class="btn-outline" href="#contact" data-need="Partner on my idea">Talk about your idea</a></p>
  </div>
</section>

<section class="band dark" id="contact">
  <div class="wrap">
    <ContactPanel eyebrow="Taking new projects" title="Tell us about your website, app or AI tool." note="You have reached the top. We are ready when you are."
      lead="Describe your project or the problem you want solved." />
  </div>
</section>

</main>
<Fragment slot="scripts"><script is:inline src="/assets/home.js"></script></Fragment>
</BaseLayout>
