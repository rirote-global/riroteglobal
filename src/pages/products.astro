---
import BaseLayout from '../layouts/BaseLayout.astro';
import Crumbs from '../components/Crumbs.astro';
import ProductShow from '../components/ProductShow.astro';
import Cta from '../components/Cta.astro';
import { breadcrumbs, webPage } from '../lib/schema';
import { ERPTICK_SHARE_IMAGE } from '../data/erptick';
import { PRODUCTS, badgeClass } from '../data/products';

const seo = {
  title: 'Software Products for Busy Operations | Rirote Global',
  path: '/products',
  description: 'ERPTick and other software products we build and run for businesses with busy operations, connected to the systems they already use.',
  image: ERPTICK_SHARE_IMAGE,
  schema: [
    webPage({ path: '/products', name: 'Products', type: 'CollectionPage' }),
    breadcrumbs(['Home', '/'], ['Products', '/products']),
  ],
};

const products = PRODUCTS.filter((p) => p.group === 'Products');
const openSource = PRODUCTS.filter((p) => p.group === 'Open source');
const icons: Record<string, string> = {
  'rirote-vision': '/assets/products/rirote-vision/logo-animated.svg',
  'code-vaidya': '/assets/products/code-vaidya/logo-mark.svg',
};

const approach = [
  ['Connected', 'Your ERP stays the source', 'Customers, machines, items and stock are read from ERPNext. Nothing is written back until you switch it on, and invoices are always created as drafts.'],
  ['Separate', 'One company, one install', "Every customer gets their own install and database, so your data is never mixed with anyone else's. Host it with us or on a server you control."],
  ['Try First', 'Start on demo data', 'ERPTick runs on a fictional demo company until you connect your ERP, so your team can try every flow before anything touches live data.'],
];
---
<BaseLayout seo={seo} nav={{ current: 'products' }}>
<main id="main">
  <section class="page-hero">
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['Products']]} />
      <p class="eyebrow">Products</p>
      <h1 class="page-title">Software we build <span>and ship ourselves.</span></h1>
      <p class="page-sub">Software for businesses with busy operations, built by the same team that builds for clients and connected to the systems you already use.</p>
      <nav class="pj" aria-label="Our products">
        {products.map((p) => (
          <a href={`#${p.id}`}><span class="pj-ico" aria-hidden="true">{icons[p.id] ? <img src={icons[p.id]} alt="" width="40" height="40"> : p.short.slice(0, 2)}</span><span><b>{p.name}</b>{p.status && <small>{p.status}</small>}</span></a>
        ))}
      </nav>
    </div>
  </section>

  <section class="band" aria-label="Products">
    <div class="wrap ps-list">
      {products.map((p, i) => <ProductShow product={p} flip={i % 2 === 1} icon={icons[p.id]} />)}
      <aside class="ps-soon" aria-labelledby="soon-title">
        <div><span class="kicker">In the works</span><h3 id="soon-title">More products are coming</h3><p>For teams that run on ERP and field operations. Want to hear when the next one is ready?</p></div>
        <a class="btn-outline" href="mailto:info@riroteglobal.com?subject=Notify%20me%20about%20new%20Rirote%20products">Get notified</a>
      </aside>
    </div>
  </section>

  <section class="band dark" id="open-source" aria-labelledby="oss-title">
    <div class="wrap">
      <p class="eyebrow">Open source</p>
      <h2 class="section-title" id="oss-title" style="margin-top:12px">Built in the open, free to use.</h2>
      <p class="section-sub">Tools and learning material we build for other engineers and give away.</p>
      <div class="oss-grid">
        {openSource.map((p) => {
          const ext = p.path.startsWith('http');
          return (
            <a class="oss-card" href={p.path} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
              <span class="oss-ico" aria-hidden="true">{'{ }'}</span>
              {p.status && <span class:list={['badge', badgeClass(p.status)]}>{p.status}</span>}
              <b>{p.name}</b><span class="oss-line">{p.line}</span>
              <span class="oss-go">{ext ? 'Open ↗' : 'Explore →'}</span>
            </a>
          );
        })}
      </div>
      <p class="seeall"><a class="more-link" href="https://github.com/rirote-global" rel="noopener">See them on GitHub →</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="approach-title">
    <div class="wrap">
      <p class="eyebrow">How our products work</p>
      <h2 class="section-title" id="approach-title" style="margin-top:12px">Built around your ERP, not beside it.</h2>
      <p class="section-sub">Our products come from the same engineering we do for clients: ticketing, dashboards and integrations built on ERPNext for manufacturers and service businesses. Here is how that works in ERPTick.</p>
      <div class="lp-cards three" style="margin-top:28px">
        {approach.map(([k, t, b]) => <div class="lp-card"><span class="kicker">{k}</span><h3>{t}</h3><p>{b}</p></div>)}
      </div>
    </div>
  </section>

  <Cta eyebrow="Something else in mind?" title="Need software that isn't here yet?" body="A custom build is often the answer. Tell us what your team needs, and we will tell you honestly whether to build, buy or extend.">
    <a href="/contact" class="btn-primary">Start a project</a>
    <a href="/services" class="btn-outline">See our services</a>
  </Cta>
</main>
</BaseLayout>
