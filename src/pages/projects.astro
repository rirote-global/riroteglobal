---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import Crumbs from '../components/Crumbs.astro';
import Cta from '../components/Cta.astro';
import { breadcrumbs, webPage } from '../lib/schema';
import { COMPANY_STATS } from '../data/site';
import { CASES, PROBLEMS } from '../data/cases';

const seo = {
  title: 'ERP, SaaS & E-commerce Case Studies | Rirote Global',
  path: '/projects',
  description: 'Case studies in enterprise ERP, manufacturing ERP, SaaS, logistics and e-commerce: what we built, the stack, and the measured results.',
  ogDescription: 'Case studies in ERP, manufacturing, e-commerce, logistics and SaaS, with the results each business saw.',
  schema: [
    webPage({ path: '/projects', name: 'Case Studies', type: 'CollectionPage' }),
    breadcrumbs(['Home', '/'], ['Work', '/projects']),
  ],
};
const usedProblems = PROBLEMS.filter((p) => CASES.some((c) => c.tags.includes(p.id)));
// NimNim leads (the fullest story), ANGARAA next (live site), then the rest in data order.
const lead = ['nimnim', 'angaraa-charcoal-website'];
const rank = (slug: string) => (lead.includes(slug) ? lead.indexOf(slug) : lead.length);
const ordered = [...CASES].sort((a, b) => rank(a.slug) - rank(b.slug));
const bars = [10, 14, 12, 19, 16, 24, 21, 30, 27, 36, 32, 43, 39, 51, 47, 60, 56, 70, 66, 82, 78, 100];
---
<BaseLayout seo={seo} nav={{ current: 'projects' }}>
<main id="main">
  <section class="page-hero">
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['Work']]} />
      <p class="eyebrow">Client Work &amp; Case Studies</p>
      <h1 class="page-title">Problems we have <span>already solved.</span></h1>
      <p class="page-sub">Websites, web apps and platforms we built or rescued, and what changed for each business, in numbers.</p>
      <div class="rise-art" aria-hidden="true">{bars.map((h, i) => <i style={`--h:${h};--i:${i}`}></i>)}<svg viewBox="12 8 43 48" width="26" height="29"><defs><linearGradient id="rg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0077b6"/><stop offset="1" stop-color="#00d4ff"/></linearGradient></defs><path fill="url(#rg)" fill-rule="evenodd" d="M13 9H37C46.9 9 54 15.8 54 24.8C54 31.4 50.2 36.7 44.4 39L54 55H41.6L33.4 40.6H25V55H13ZM33.5 15.5L42.6 26.4H36.9V32.8H30.1V26.4H24.4Z"/></svg></div>
      <div class="stats wk-stats">
        <div><b data-count>{COMPANY_STATS.projects.value}</b><span>{COMPANY_STATS.projects.label}</span></div>
        <div><b data-count>{COMPANY_STATS.industries.value}</b><span>{COMPANY_STATS.industries.label}</span></div>
        <div><b data-count>{COMPANY_STATS.regions.value}</b><span>{COMPANY_STATS.regions.label}</span></div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="work-title">
   <div class="wrap" data-filters>
    <div class="wk-head">
      <div><p class="eyebrow">Selected work</p><h2 class="section-title" id="work-title" style="margin-top:12px">Pick a problem.</h2></div>
      <p class="nda-note">Most client names and details are withheld under NDA, so those cases are drawn, not screenshotted.</p>
    </div>
    <div class="filters wk-filters" role="group" aria-label="Filter by problem">
      <button class="fchip" type="button" data-key="tags" data-val="" aria-pressed="true">All</button>
      {usedProblems.map((p) => <button class="fchip" type="button" data-key="tags" data-val={p.id} aria-pressed="false">{p.label}</button>)}
    </div>
    <p class="fcount" data-filter-count data-noun="case studies" role="status"></p>
    <div class="wk-grid">{ordered.map((c, i) => <CaseCard study={c} featured={i === 0} />)}</div>
    <p class="note2" data-filter-empty hidden>No case studies for this one yet. Tell us about your problem anyway.</p>
   </div>
  </section>

  <Cta eyebrow="Your Project" title="Have a problem like these?" body="Tell us what you're working on and what is getting in the way. We'll get back to you as soon as we can.">
    <a href="/contact" class="btn-primary">Start a Conversation</a>
    <a href="/services" class="btn-outline">See Our Services</a>
  </Cta>
</main>
</BaseLayout>
