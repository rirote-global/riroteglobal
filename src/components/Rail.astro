---
// The signature, for long pages. Desktop: a see-through rail on the left with a stop per section; an R climbs it as
// the page is read and lands on the last stop (usually contact): the summit. Phones: two buttons in thumb reach
// whose top edge fills as the page is read. Behaviour in site.js; styles in site.css "Signature".
export interface Props {
  stops: Array<[id: string, label: string]>;
  summitLabel?: string;
}
const { stops, summitLabel = 'Start a project' } = Astro.props;
const last = stops.length - 1;
const target = stops[last][0];
---
<nav class="climb" aria-label="Page sections" data-summit={summitLabel}>
  <i aria-hidden="true"></i><b aria-hidden="true"></b>
  {stops.map(([id, label], i) => (
    <a class:list={['stop', { last: i === last }]} href={`#${id}`} data-id={id} style={`top:${(1 - i / last) * 100}%`}><span>{label}</span></a>
  ))}
</nav>
<div class="dock" data-dock={target} aria-hidden="true">
  <a class="btn-outline" href="/projects" tabindex="-1">Work</a>
  <a class="btn-primary" href={`#${target}`} tabindex="-1">{summitLabel}</a>
</div>
