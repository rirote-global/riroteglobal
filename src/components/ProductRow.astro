---
// One product as a full-width row: name, status, pitch and actions beside a screenshot, or beside its key
// points when there is no screenshot yet, so a product without screens never leaves an empty box.
import { PROBLEMS } from '../data/cases';
import { badgeClass, type Product } from '../data/products';

export interface Props {
  product: Product;
  /** Show which problems it solves (the /products page, where they back the filter). */
  showTags?: boolean;
  /** Overrides the screenshot's alt text for this placement. */
  shotAlt?: string;
}
const { product: p, showTags = false, shotAlt } = Astro.props;
const external = p.path.startsWith('http');
const linkProps = external ? { target: '_blank', rel: 'noopener' } : {};
const shot = p.shot;
const dl = p.download?.available ? p.download : undefined;
const label = (id: string) => PROBLEMS.find((x) => x.id === id)?.label ?? id;
---
<article class:list={['prow', { solo: !shot && p.points.length === 0 }]} data-item data-status={(p.status ?? '').replace(/ /g, '-')} data-tags={p.tags.join(' ')} data-reveal>
  <div class="prow-text">
    {p.status && <span class:list={['badge', badgeClass(p.status)]}>{p.status}</span>}
    <h3><a href={p.path} {...linkProps}>{p.name}</a></h3>
    <p class="prow-line">{p.line}</p>
    {shot && <ul class="mini-pts">{p.points.map((x) => <li>{x}</li>)}</ul>}
    {showTags && <ul class="tagcloud" aria-label="Problems it solves">{p.tags.map((t) => <li>{label(t)}</li>)}</ul>}
    <div class="cta-row">
      <a class="btn-primary" href={p.path} {...linkProps}>Explore {p.short} {external ? '↗' : '→'}</a>
      {dl
        ? <a class="btn-outline" href={dl.href} download>{dl.label}</a>
        : p.rowCta && <a class="btn-outline" href={p.rowCta.href}>{p.rowCta.label}</a>}
    </div>
  </div>
  {shot ? (
    <a class="prow-shot" href={shot.href ?? p.path} aria-label={shot.hrefLabel ?? `See ${p.name}`}>
      <img src={shot.poster ?? shot.src} srcset={shot.srcset}
        sizes="(max-width: 900px) 100vw, 50vw" width={shot.width} height={shot.height} loading="lazy" decoding="async" alt={shotAlt ?? shot.alt}>
      {shot.playLabel && <span class="prow-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M7 4v16l13-8z"/></svg>{shot.playLabel}</span>}
    </a>
  ) : p.points.length > 0 && (
    <ul class="big-pts">{p.points.map((x) => <li>{x}</li>)}</ul>
  )}
</article>
