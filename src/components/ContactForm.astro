---
// The real enquiry form: posts to Web3Forms from site.js, with validation and a honeypot.
// "What do you need?" is a dropdown named `service`, so the email still says what was picked.
// The hint under the message changes with the choice. The contact page pre-fills it from ?service= and ?message=;
// a service with no card of its own (a product, say) gets a card added and ticked.
import { SERVICES } from '../data/services';
export interface Props { service?: string; message?: string; }
const { service, message } = Astro.props;

const short: Record<string, [string, string]> = {
  'Websites & Web Apps': ['Website or web app', 'A new site, an app, or a faster one'],
  'AI Assistants & Automation': ['AI solution', 'Assistants and automations'],
  'ERP Integration': ['ERP integration', 'Connect or extend your ERP'],
  'Hosting, Speed & Security': ['Hosting & security', 'Faster, safer, cheaper hosting'],
  'Technical Advice & Team Leadership': ['Technical advice', 'A plan or a lead for your team'],
  'Hire Dedicated Developers': ['Hire developers', 'Add people to your team'],
};
const hints: Record<string, string> = {
  'Websites & Web Apps': 'What is the business, and what should the site or app do?',
  'AI Assistants & Automation': 'What work should AI help with, and on which data?',
  'ERP Integration': 'Which ERP do you use, and what should it connect to?',
  'Hosting, Speed & Security': 'Where is it hosted today, and what is going wrong?',
  'Technical Advice & Team Leadership': 'What decision or project do you need help with?',
  'Hire Dedicated Developers': 'Which skills, for how long, and full-time or part-time?',
  'Partner on my idea': 'What is the idea, and where are you with it now?',
  'Code Vaidya (aftercare)': 'What is the website or app, and who looks after it today?',
  'Something Else': 'What problem are you trying to solve?',
};
const cards: Array<{ value: string; title: string; text: string }> = [
  ...SERVICES.map((s) => ({ value: s.name, title: short[s.name]?.[0] ?? s.name, text: short[s.name]?.[1] ?? s.summary })),
  { value: 'Partner on my idea', title: 'Partner on my idea', text: 'Start small, grow together' },
  { value: 'Code Vaidya (aftercare)', title: 'Code Vaidya', text: 'Aftercare, in beta testing' },
];
if (service && !cards.some((c) => c.value === service)) cards.unshift({ value: service, title: service.replace(/ \(our product\)$/, ''), text: 'Our product' });
cards.push({ value: 'Something Else', title: 'Not sure yet', text: 'Tell us the problem' });
const defaultHint = 'Tell us about the project, or the problem you want solved.';
---
<form id="contactForm" novalidate>
  <div class="field">
    <label for="cf-service">What do you need?</label>
    <select id="cf-service" name="service">
      <option value="" data-hint={defaultHint}>Choose one…</option>
      {cards.map((c) => <option value={c.value} selected={c.value === service} data-hint={hints[c.value] ?? defaultHint}>{c.title}{c.value === 'Code Vaidya (aftercare)' ? ' (aftercare, beta)' : ''}</option>)}
    </select>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" maxlength="100" enterkeyhint="next" required>
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" enterkeyhint="next" required>
    </div>
  </div>
  <div class="field">
    <label for="cf-company">Company <span class="opt">(optional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="120" enterkeyhint="next">
  </div>
  <div class="field">
    <label for="cf-message">Tell us a little</label>
    <p class="hint" id="cf-hint" data-default={defaultHint}>{(service && hints[service]) || defaultHint}</p>
    <textarea id="cf-message" name="message" rows="4" maxlength="4000" aria-describedby="cf-hint" required>{message}</textarea>
  </div>
  <!-- Honeypot: hidden from people, filled by bots. Web3Forms drops any submission that ticks it. -->
  <input type="checkbox" name="botcheck" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
  <button type="submit" class="btn-primary btn-send">Send message
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 1 22 13h-6v10H8V13H2z"/></svg>
  </button>
  <p class="contact-note">By sending this form you agree to our <a href="/privacy-policy">Privacy Policy</a>.</p>
  <p class="contact-status" id="contactStatus" role="status" aria-live="polite"></p>
</form>
